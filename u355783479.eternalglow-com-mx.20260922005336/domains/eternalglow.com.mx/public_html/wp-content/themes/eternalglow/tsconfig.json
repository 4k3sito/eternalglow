{
    "compilerOptions": {
        "outDir": "./dist/",
        "noImplicitAny": true,
        "module": "es6",
        "target": "es5",
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "node",
        "baseUrl": ".",
        "allowSyntheticDefaultImports": true,
        "paths": {
			"Scss/*": ["assets/scss/*"],
			"Ts/*": ["assets/ts/*"],
			"Css/*": ["assets/css/*"],
        },
    },
}